//
// @file bitset.rho
// @brief A set of small integers, one bit each, over words the caller owns.
//
// A BitSet is the 64-bit words the caller owns, given as a Slice[u64] — a fixed
// array `u64[N]` converts to one — so passing one passes the set rather than a
// copy of it: `set(b, 3)` changes the words the
// caller holds. Bit `i` is bit `i % 64` of word `i / 64`. An index past the last
// word is outside the set: `set` and `clear` leave the words alone and `get`
// answers false, so a stray index never writes past the caller's array.
//
// Pure Rho, the same on every backend.
//
// @stability experimental
//
// @project Rho Programming Language
// @version 0.3
// @date 2026
//
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//

module std.collections.bitset

import std.core.ptr
import std.core.slice

struct BitSet {
    data: Ptr[u64]
    words: u32
}

// bitset is the set over the words of a Slice, each 64 bits of it.
fn bitset(words: Slice[u64]) BitSet {
    return BitSet{ words.ptr, words.len }
}

// capacity is how many bits the set holds.
fn capacity(b: BitSet) u32 {
    return b.words * 64
}

fn set(b: BitSet, idx: u32) void {
    let word: u32 = idx / 64
    if word >= b.words {
        return
    }
    let bit: u32 = idx % 64
    b.data[word] = b.data[word] | (u64(1) << bit)
}

fn clear(b: BitSet, idx: u32) void {
    let word: u32 = idx / 64
    if word >= b.words {
        return
    }
    let bit: u32 = idx % 64
    b.data[word] = b.data[word] & ~(u64(1) << bit)
}

fn get(b: BitSet, idx: u32) bool {
    let word: u32 = idx / 64
    if word >= b.words {
        return false
    }
    let bit: u32 = idx % 64
    return (b.data[word] & (u64(1) << bit)) != 0
}
