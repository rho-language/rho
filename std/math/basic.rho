module std.math.basic

fn min_u32(a: u32, b: u32) u32 {
    if a < b { return a }
    return b
}

fn max_u32(a: u32, b: u32) u32 {
    if a > b { return a }
    return b
}

fn abs_i32(x: i32) i32 {
    if x < 0 { return -x }
    return x
}

fn clamp_u32(x: u32, lo: u32, hi: u32) u32 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}
