module std.math.fast

extern fn rho_sin(x: f64) f64
extern fn rho_cos(x: f64) f64
extern fn rho_sqrt(x: f64) f64
extern fn rho_atan2(y: f64, x: f64) f64

fn fast_sin(x: f64) f64 { return rho_sin(x) }
fn fast_cos(x: f64) f64 { return rho_cos(x) }
fn fast_sqrt(x: f64) f64 { return rho_sqrt(x) }
fn fast_atan2(y: f64, x: f64) f64 { return rho_atan2(y, x) }