//
// @file modbus.rho
// @brief Modbus RTU framing and its CRC-16 over RS-485.
//
// Backend: C. It drives std.embedded.rs485, whose UART and GPIO `*_hw_*` functions are `extern fn` that a board's
// platform implements in C, so a program using it builds for any board whose
// platform provides them. No Go target has a platform that supplies them, so a
// Go build that imports it is refused, naming the module, rather than failing
// with "undefined". On a host the externs can be supplied by the program's own C
// (the toolchain's tests do that, with stubs).
//
// @backends c
//
// @stability experimental
//
// @project Rho Programming Language
// @version 0.1
// @date 2026
//
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//

module std.embedded.modbus

import std.core.slice
import std.core.ptr
import std.embedded.rs485

struct Modbus {
    bus: RS485
    addr: u8
}

fn init(bus: RS485, addr: u8) Modbus {
    return Modbus{ bus, addr }
}

fn crc16_modbus(data: Slice[u8]) u16 {
    var crc: u16 = 0xFFFF

    var i: u32 = 0
    while i < data.len {
        crc = crc ^ u16(data[i])

        var j: u32 = 0
        while j < 8 {
            if (crc & 0x0001) != 0 {
                crc = (crc >> 1) ^ 0xA001
            } else {
                crc = crc >> 1
            }
            j = j + 1
        }

        i = i + 1
    }

    return crc
}

fn read_holding(m: Modbus, start: u16, qty: u16, out: Slice<u16>) bool {
    let buf_raw: u8[8]
    let buf: Slice[u8] = buf_raw

    buf[0] = m.addr
    buf[1] = 0x03
    buf[2] = u8(start >> 8)
    buf[3] = u8(start & 0xFF)
    buf[4] = u8(qty >> 8)
    buf[5] = u8(qty & 0xFF)

    let crc: u16 = crc16_modbus(buf[..6])
    buf[6] = u8(crc & 0xFF)        // low byte first
    buf[7] = u8(crc >> 8)

    rs485.write(m.bus, buf)

    // the reply: addr, func, byte_count, data..., crc_lo, crc_hi
    let rx_raw: u8[64]
    let rx: Slice[u8] = rx_raw

    let n: u32 = rs485.read(m.bus, rx)
    if n < 5 {
        return false
    }

    // check the CRC
    let crc_calc: u16 = crc16_modbus(rx[..n - 2])
    let crc_lo: u8 = rx[n - 2]
    let crc_hi: u8 = rx[n - 1]
    let crc_recv: u16 = u16(crc_lo) | (u16(crc_hi) << 8)

    if crc_calc != crc_recv {
        return false
    }

    // extragem registrele
    let byte_count: u8 = rx[2]
    if u32(byte_count) != qty * 2 {
        return false
    }

    var i: u32 = 0
    while i < u32(qty) && i < out.len {
        let base: u32 = 3 + i * 2
        let hi: u8 = rx[base]
        let lo: u8 = rx[base + 1]
        out[i] = (u16(hi) << 8) | u16(lo)
        i = i + 1
    }

    return true
}
