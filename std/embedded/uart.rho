//
// @file uart.rho
// @brief A UART: configure the baud rate, write and read bytes.
//
// Backend: C. The `*_hw_*` functions it declares are `extern fn` that a board's
// platform implements in C, so a program using it builds for any board whose
// platform provides them. No Go target has a platform that supplies them, so a
// Go build that imports it is refused, naming the module, rather than failing
// with "undefined". On a host the externs can be supplied by the program's own C
// (the toolchain's tests do that, with stubs).
//
// @backends c
//
// @stability experimental
//
// @project Rho Programming Language
// @version 0.1
// @date 2026
//
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//

module std.embedded.uart

import std.core.slice
import std.core.ptr

extern fn uart_hw_init(baud: u32) void
extern fn uart_hw_write(ptr: Ptr[u8], len: u32) void
extern fn uart_hw_read(ptr: Ptr[u8], len: u32) u32

fn init(baud: u32) void {
    uart_hw_init(baud)
}

fn write(s: Slice[u8]) void {
    uart_hw_write(s.ptr, s.len)
}

fn read(out: Slice[u8]) u32 {
    return uart_hw_read(out.ptr, out.len)
}
