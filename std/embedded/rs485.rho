//
// @file rs485.rho
// @brief RS-485 over a UART, with driver-enable and receiver-enable pins.
//
// Backend: C. It drives std.embedded.uart and std.embedded.gpio, whose `*_hw_*` functions are `extern fn` that a board's
// platform implements in C, so a program using it builds for any board whose
// platform provides them. No Go target has a platform that supplies them, so a
// Go build that imports it is refused, naming the module, rather than failing
// with "undefined". On a host the externs can be supplied by the program's own C
// (the toolchain's tests do that, with stubs).
//
// @backends c
//
// @stability experimental
//
// @project Rho Programming Language
// @version 0.1
// @date 2026
//
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//

module std.embedded.rs485

import std.core.slice
import std.core.ptr
import std.embedded.uart
import std.embedded.gpio

struct RS485 {
    de_pin: u32
    re_pin: u32
}

fn init(de_pin: u32, re_pin: u32, baud: u32) RS485 {
    // configure UART
    uart.init(baud)

    // configure DE/RE pins
    gpio.init(de_pin, 1)   // 1 = output
    gpio.init(re_pin, 1)

    // default: RX mode
    gpio.write(de_pin, false)
    gpio.write(re_pin, false)

    return RS485{ de_pin, re_pin }
}

fn set_direction(dev: RS485, tx: bool) void {
    if tx {
        // TX mode: DE=1, RE=1
        gpio.write(dev.de_pin, true)
        gpio.write(dev.re_pin, true)
    } else {
        // RX mode: DE=0, RE=0
        gpio.write(dev.de_pin, false)
        gpio.write(dev.re_pin, false)
    }
}

fn write(dev: RS485, data: Slice[u8]) void {
    set_direction(dev, true)
    uart.write(data)
    // small turnaround delay (hardware-specific)
    // in Rho 0.1: user handles delay externally
    set_direction(dev, false)
}

fn read(dev: RS485, out: Slice[u8]) u32 {
    set_direction(dev, false)
    return uart.read(out)
}
