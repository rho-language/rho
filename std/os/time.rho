module std.os.time

// The realtime clock, read once in nanoseconds since the Unix epoch so the
// seconds and the fraction belong to the same moment.
extern fn rho_time_now_ns() u64

struct TimeSpec {
    sec: u64
    nsec: u64
}

fn now() TimeSpec {
    let ns: u64 = rho_time_now_ns()
    return TimeSpec{ ns / 1000000000, ns % 1000000000 }
}
