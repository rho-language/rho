module std.os.fs

import std.os.sys
import std.core.ptr
import std.core.option

fn open(path: Ptr[u8], flags: u32) Result[u32, u32] {
    let fd: u64 = c_syscall(2, path.raw, flags, 0, 0, 0, 0)
    if fd == u64(-1) {
        return Err[u32, u32](1)   // simplu: 1 = error
    }
    return Ok[u32, u32](u32(fd))
}

fn close(fd: u32) u32 {
    return u32(c_syscall(3, fd, 0, 0, 0, 0, 0))
}
