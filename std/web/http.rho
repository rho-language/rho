module std.web.http

// Response is what an HTTP handler returns. The Go backend generates the
// matching type for a server target, so a handler only ever works with these
// two shapes.

// text builds a plain text response.
fn text(status: u32, body: string) Response {
    return Response{ status, body, "text/plain; charset=utf-8", "" }
}

// json builds a JSON response.
fn json(status: u32, body: string) Response {
    return Response{ status, body, "application/json", "" }
}

// Common status codes, so handlers read as protocol rather than as numbers.
fn status_ok() u32 {
    return 200
}

fn status_created() u32 {
    return 201
}

fn status_no_content() u32 {
    return 204
}

fn status_bad_request() u32 {
    return 400
}

fn status_unauthorized() u32 {
    return 401
}

// status_forbidden is a request the caller may not make, as distinct from one
// they may not be identified for: 401 says who are you, 403 says you are known
// and the answer is still no. A registry uses the second when a credential is
// valid and its holder is not the module's owner.
fn status_forbidden() u32 {
    return 403
}

fn status_not_found() u32 {
    return 404
}

fn status_conflict() u32 {
    return 409
}

fn status_payload_too_large() u32 {
    return 413
}

fn status_internal() u32 {
    return 500
}

// html builds an HTML response, for a page served alongside the API.
fn html(status: u32, body: string) Response {
    return Response{ status, body, "text/html; charset=utf-8", "" }
}

// sse_file streams a file as Server-Sent Events. Each line becomes one event;
// a line beginning with __DONE__: closes the stream with a `done` event whose
// data is the exit status. The interval is how long the server waits before
// looking for more when the file has no new line.
//
// It is how a long step reports progress: the action writes its output to a
// file, and the page listens to the same file instead of waiting for the whole
// request to finish.
extern fn sse_file(path: string, interval_ms: u32) Response

// sse_events streams named HTML fragments as Server-Sent Events. Each line of
// path is a JSON object {"event":"...","data":"..."}; data may contain
// newlines. When snapshot names a readable file, its lines are sent from the
// start first, so a page that connects sees current state before later
// changes; path is then followed from its end.
//
// It is the stream a page uses with HTMX: the event name selects the target
// and the data is the HTML fragment that target swaps in.
extern fn sse_events(path: string, snapshot: string, interval_ms: u32) Response



// status_found is a redirect the browser follows with a GET.
fn status_found() u32 {
    return 302
}

// redirect sends the browser to a URL. Headers carry the Location line, the
// same shape a handler uses for a cookie.
fn redirect(location: string) Response {
    return Response{ status_found(), "", "text/plain; charset=utf-8", "Location: " + location }
}

// response_header appends header lines to a response. The Go backend owns the
// response's header block, so the lines are added there rather than by taking
// the response apart in Rho.
extern fn response_header(resp: Response, headers: string) Response

// with_headers returns a response with one more header, so a handler can add a
// cookie or an HTMX response header without giving up the content type or body
// it already chose.
fn with_headers(resp: Response, headers: string) Response {
    return response_header(resp, headers)
}
