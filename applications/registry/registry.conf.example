# Registry settings.
#
# Read at start-up from, in order of precedence:
#   1. the file named by RHO_REGISTRY_CONFIG
#   2. ~/.rho/registry/registry.conf
#
# Every setting has a default, so a registry runs with no settings file at all.
# The file is `key = value` lines; # starts a comment.

# Where published modules are stored. Keep this outside the application
# directory, so installing a new build cannot take the modules with it.
# An environment variable RHO_REGISTRY_DATA overrides it, which is what a
# container uses.
data_dir = data

# public  - any identity with a token may publish; reading is open
# secured - only identities named in RHO_REGISTRY_ALLOWED_USERS may publish
#
# Reading is public either way: the index, search, a version list, a module's
# documentation and its download need no credential.
access = public

# Shown on the pages.
title = Rho module registry
site_url = https://rho-lang.org

# The address this service is published under. Generated documentation links
# back here, so a reader who follows a module's docs can return. Set it to the
# public URL when the service is behind a proxy or a name.
registry_url = /

# How long an issued token lasts, and the ceiling a caller may ask for.
# token_days is clamped to token_max_days, and never exceeds 90 days.
token_days = 30
token_max_days = 90

# Whether a token can be issued without already holding one. Closed, so the
# set of people who may publish is the set an administrator decides.
#
# A deployment that opened this would mint a token for any name it was handed,
# which is a registry with no owners at all. To obtain the first token, set
# RHO_REGISTRY_BOOTSTRAP_SECRET in the environment and present it; to let a user
# obtain their own, add them to RHO_REGISTRY_ALLOWED_USERS. Set this to true only
# for a laptop or a test.
open_tokens = false

# The largest package accepted, in megabytes. The HTTP server's body ceiling is
# derived from this, so raising it is enough; a reverse proxy in front must allow
# at least as large a body (nginx: client_max_body_size).
max_upload_mb = 16
