module registry.web

// The browsable side of the registry.
//
// Four public pages: an index of modules with the newest version badged, a
// search, a module's versions newest first, and a version's detail. The markup
// lives in the template files, so this only decides which values go where.
//
// Nothing here needs a credential. Publishing is what a token is for, and that
// check lives with the publish handler.

import std.web.http
import std.web.template
import registry.docs

/* -------------------------------------------------------------------------- */
/*  Routes                                                                    */
/* -------------------------------------------------------------------------- */

route GET "/"                         => index_page
route GET "/search"                   => search_page
route GET "/modules/{name}"           => module_page
route GET "/modules/{name}/{version}" => version_page

/* -------------------------------------------------------------------------- */
/*  Handlers                                                                  */
/* -------------------------------------------------------------------------- */

// index_page lists the published modules, each with its newest version.
fn index_page(req: Request) Response {
    let query: string = request_query_param(req, "q")
    let listing: string = store_meta(query)
    return html(200, page(req, fill(template_get("index"),
        vars("crumb", crumb("")) +
        vars("listing", module_rows(listing)) +
        vars("count", int_to_str(line_count(listing))) +
        vars("noun", noun_for(listing)) +
        vars("heading", heading_for(query)))
    ))
}

// search_page lists every module matching a query, with all of its versions.
fn search_page(req: Request) Response {
    let query: string = request_query_param(req, "q")
    let listing: string = store_meta(query)
    return html(200, page(req, fill(template_get("index"),
        vars("crumb", crumb(search_trail(query))) +
        vars("listing", version_rows(listing, "Nothing matches that.")) +
        vars("count", int_to_str(line_count(listing))) +
        vars("noun", "module") +
        vars("heading", heading_for(query)))
    ))
}

// module_page lists one module's versions, newest first.
fn module_page(req: Request) Response {
    let name: string = param(req, "name")
    if !valid_name(name) {
        return missing(req, "That module name is not valid.")
    }
    let listing: string = store_detail(name)
    if line_count(listing) == 0 {
        return missing(req, "No such module.")
    }
    return html(200, page(req, fill(template_get("index"),
        vars("crumb", crumb(module_trail(name))) +
        vars("listing", version_rows(listing, "No versions published yet.")) +
        vars("count", int_to_str(line_count(listing))) +
        vars("noun", "version") +
        vars("heading", "Versions of " + name))
    ))
}

// version_page shows one published version's public metadata.
fn version_page(req: Request) Response {
    let name: string = param(req, "name")
    let version: string = param(req, "version")
    if !valid_name(name) || !valid_version(version) {
        return missing(req, "That module is not valid.")
    }
    let found: string = find_version(store_detail(name), version)
    if found == "" {
        return missing(req, "No such version.")
    }
    return html(200, page(req, fill(template_get("detail"),
        vars("crumb", crumb(version_trail(name, version))) +
        vars("name", field_of(found, 0)) +
        vars("version", field_of(found, 1)) +
        vars("kind", field_of(found, 2)) +
        vars("description", fallback(field_of(found, 3), "No description.")) +
        vars("main", field_of(found, 4)) +
        vars("command", field_of(found, 5)) +
        vars("doc", doc_link(field_of(found, 0), version)))
    ))
}

// missing renders a 404 page.
fn missing(req: Request, message: string) Response {
    return html(404, page(req, fill(template_get("notfound"), vars("message", message))))
}

/* -------------------------------------------------------------------------- */
/*  Page assembly                                                             */
/* ----------------------------------------------------------------             */
/*  Every page carries the same header, search box and footer, so they are   */
/*  wrapped once here rather than repeated per template.                      */
/* -------------------------------------------------------------------------- */

// page wraps a body in the shared layout.
fn page(req: Request, body: string) string {
    return page_shell(registry_title(), request_query_param(req, "q"), body)
}

// page_shell wraps a body in the shared layout without a request, for a handler
// that has no search box to fill: a page the service answers on its own, such as
// the not-found page for a module with no documentation. Wrapping lives here, so
// a second copy of the layout cannot drift from this one.
fn page_shell(title: string, query: string, body: string) string {
    let open: string = template_fill(
        template_get("layout-open"),
        vars("title", title) +
        vars("query", query)
    )
    let close: string = template_fill(
        template_get("layout-close"),
        vars("title", title) +
        vars("version", registry_version()) +
        vars("year", int_to_str(clock_year())) +
        vars("site_url", registry_site_url())
    )
    return open + body + close
}

/* -------------------------------------------------------------------------- */
/*  Row rendering                                                             */
/* -------------------------------------------------------------------------- */

// module_rows renders one row per module, with its newest version badged.
fn module_rows(listing: string) string {
    let out: string = ""
    let count: u32 = 0
    let rest: string = listing
    while guard_of(count) < 4096 {
        let line: string = first_line(rest)
        if strlen(line) == 0 {
            break
        }
        out = out + template_fill(
            template_get("row"),
            vars("name", field_of(line, 0)) +
            vars("version", field_of(line, 1)) +
            vars("description", field_of(line, 3)) +
            vars("doc", doc_badge(field_of(line, 0), field_of(line, 1)))
        )
        count = count + 1
        rest = after_first_line(rest)
    }
    if count == 0 {
        return empty("No modules published yet.")
    }
    return "<ul>" + out + "</ul>"
}

// version_rows renders one row per version, each linking to its detail page.
fn version_rows(listing: string, when_empty: string) string {
    let out: string = ""
    let count: u32 = 0
    let rest: string = listing
    while guard_of(count) < 4096 {
        let line: string = first_line(rest)
        if strlen(line) == 0 {
            break
        }
        out = out + template_fill(
            template_get("version"),
            vars("name", field_of(line, 0)) +
            vars("version", field_of(line, 1)) +
            vars("description", field_of(line, 3)) +
            vars("doc", doc_badge(field_of(line, 0), field_of(line, 1)))
        )
        count = count + 1
        rest = after_first_line(rest)
    }
    if count == 0 {
        return empty(when_empty)
    }
    return "<ul>" + out + "</ul>"
}

// crumb is the trail at the top of a page: where it is, and the way back up.
//
// Every page about a module carries one. A registry's pages are a hierarchy —
// the index, a module, a version — and a reader who is three levels down needs to
// see the way back without reading the address.
fn crumb(trail: string) string {
    return template_fill(template_get("crumb"),
        vars("home", registry_title()) +
        vars("trail", trail))
}

fn search_trail(query: string) string {
    if query == "" {
        return ""
    }
    return " / <a href=\"/search?q=" + query + "\">search " + query + "</a>"
}

fn module_trail(name: string) string {
    return " / " + name
}

fn version_trail(name: string, version: string) string {
    return module_trail(name) + " / " + version
}

fn empty(message: string) string {
    return template_fill(template_get("empty"), vars("message", message))
}

// find_version returns the listing line for one version, or "" when absent.
fn find_version(listing: string, version: string) string {
    let rest: string = listing
    let count: u32 = 0
    while guard_of(count) < 4096 {
        let line: string = first_line(rest)
        if strlen(line) == 0 {
            break
        }
        if field_of(line, 1) == version {
            return line
        }
        rest = after_first_line(rest)
        count = count + 1
    }
    return ""
}

/* -------------------------------------------------------------------------- */
/*  Line helpers                                                              */
/*                                                                             */
/*  A listing is tab-separated lines, so a handler can read it without needing */
/*  to walk a nested document.                                                 */
/* -------------------------------------------------------------------------- */

// first_line returns the text up to the first newline.
fn first_line(text: string) string {
    let stop: i32 = str_index_of(text, "\n")
    if stop < 0 {
        return text
    }
    return str_slice(text, 0, stop as u32)
}

// after_first_line returns everything after the first newline.
fn after_first_line(text: string) string {
    let stop: i32 = str_index_of(text, "\n")
    if stop < 0 {
        return ""
    }
    let start: u32 = (stop as u32) + 1
    return str_slice(text, start, strlen(text))
}

// field_of returns one tab-separated field of a line.
fn field_of(line: string, wanted: u32) string {
    let at: u32 = 0
    let seen: u32 = 0
    let length: u32 = strlen(line)
    while at <= length {
        if seen == wanted {
            let stop: i32 = str_index_of(str_slice(line, at, length), "\t")
            if stop < 0 {
                return str_slice(line, at, length)
            }
            return str_slice(line, at, stop as u32)
        }
        if at < length && str_at(line, at) == 9 {
            seen = seen + 1
        }
        at = at + 1
    }
    return ""
}

// line_count counts the entries in a listing.
fn line_count(listing: string) u32 {
    let count: u32 = 0
    let rest: string = listing
    while guard_of(count) < 4096 {
        if strlen(first_line(rest)) == 0 {
            break
        }
        count = count + 1
        rest = after_first_line(rest)
    }
    return count
}

// guard_of keeps a walk bounded, so a malformed listing cannot spin forever.
fn guard_of(count: u32) u32 {
    return count
}

/* -------------------------------------------------------------------------- */
/*  Presentation helpers                                                       */
/* -------------------------------------------------------------------------- */

fn fallback(value: string, when_empty: string) string {
    if value == "" {
        return when_empty
    }
    return value
}

fn heading_for(query: string) string {
    if query == "" {
        return "Modules"
    }
    return "Modules matching " + query
}

fn noun_for(listing: string) string {
    if line_count(listing) == 1 {
        return "module"
    }
    return "modules"
}
