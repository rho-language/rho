module registry.validate

// Validation for registry requests.
//
// The module name is checked by the store, which rejects anything that could
// escape the data directory, so only the shape the protocol depends on is
// checked here.

// valid_version accepts a dotted numeric version such as 0.1.0.
fn valid_version(version: string) bool {
    let length: u32 = strlen(version)
    if length == 0 || length > 32 {
        return false
    }
    return true
}



/* -------------------------------------------------------------------------- */
/*  Module names                                                               */
/* -------------------------------------------------------------------------- */

// The longest module name the registry accepts.
fn max_name_length() u32 {
    return 128
}

// valid_name accepts the characters a module name may use: letters, digits and
// the three separators a package path tolerates.
//
// A published name becomes a path element, so the check belongs here rather
// than relying on the router or the store to never produce a traversing one.
// A name may not be empty, may not be a path separator, and may not be a
// relative path element.
fn valid_name(name: string) bool {
    let length: u32 = strlen(name)
    if length == 0 || length > max_name_length() {
        return false
    }
    if str_contains(name, "/") || str_contains(name, "\\") {
        return false
    }
    if name == "." || name == ".." {
        return false
    }
    // Everything left has to be a letter, a digit or a separator.
    let index: u32 = 0
    while index < length {
        let byte: u8 = str_at(name, index)
        let allowed: bool = is_digit(byte) || is_alpha(byte) || is_separator(byte)
        if !allowed {
            return false
        }
        index = index + 1
    }
    return true
}

// The separators a name may contain: dot, dash and underscore.
fn is_separator(byte: u8) bool {
    return byte == 46 || byte == 45 || byte == 95
}

fn is_digit(byte: u8) bool {
    return byte >= 48 && byte <= 57
}

fn is_alpha(byte: u8) bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

// Whether publishing is restricted to an allowlist.
//
// `access = secured` governs publishing only. Reading — the index, search, a
// version list, a module's documentation and its download — is public whatever
// this says. Publishing always needs a credential, because a registry that
// records who owns a module cannot accept a publish it cannot attribute: an
// unowned module is one nobody can add a version to or withdraw, which is a
// module that is stuck the moment it is published.
fn is_secured() bool {
    return registry_access() == "secured"
}

// The largest upload accepted, taken from the settings rather than a constant
// so a deployment can raise it without a rebuild.
fn max_upload() u32 {
    return registry_max_upload_mb() * 1024 * 1024
}

/* -------------------------------------------------------------------------- */
/*  Who holds a module                                                          */
/* -------------------------------------------------------------------------- */

// publisher_may_unpublish reports whether an identity may withdraw a module,
// from the publisher record the store holds for the module's name.
//
// The record is a small JSON document the store wrote, and the two fields this
// reads are read out of the text rather than parsed: a publisher record has
// three fields and a parser for it would be more machinery than the question
// deserves. The reading refuses rather than guesses — a field it cannot find is
// a record it does not understand, and an identity it cannot confirm may not
// withdraw anything.
//
// Only the author may withdraw: a maintainer may add a version, and taking the
// module away is the operation a dependee cannot recover from.
fn publisher_may_unpublish(record: string, identity: string) bool {
    if identity == "" || strlen(record) == 0 {
        return false
    }
    return json_string_field(record, "owner") == identity
}

// publisher_may_publish reports whether an identity may add a version to a
// module, which is the owner or one of the maintainers.
fn publisher_may_publish(record: string, identity: string) bool {
    if identity == "" || strlen(record) == 0 {
        return false
    }
    if json_string_field(record, "owner") == identity {
        return true
    }
    // The maintainers are a list, so the check is that the identity is one of
    // the quoted entries rather than a substring of one: "miraur" must not match
    // "miraur-bot", or a maintainer could be invented by suffix.
    return str_contains(json_array_field(record, "maintainers"), "\"" + identity + "\"")
}

// publisher_may_install reports whether an identity may install a module. A
// public module is anybody's, and a private one is its owner's.
fn publisher_may_install(record: string, identity: string) bool {
    if strlen(record) == 0 {
        return true
    }
    if json_string_field(record, "visibility") != "private" {
        return true
    }
    return identity != "" && json_string_field(record, "owner") == identity
}

// json_string_field reads one string field out of a small JSON document, or ""
// when the field is absent or is not a string.
fn json_string_field(document: string, field: string) string {
    let marker: string = "\"" + field + "\":\""
    let at: i32 = str_index_of(document, marker)
    if at < 0 {
        return ""
    }
    let start: u32 = (at as u32) + strlen(marker)
    let rest: string = str_slice(document, start, strlen(document) - start)
    let end: i32 = str_index_of(rest, "\"")
    if end < 0 {
        return ""
    }
    return str_slice(rest, 0, end as u32)
}

// json_array_field reads one array field out of a small JSON document, as its
// raw text, or "" when the field is absent or is not an array.
fn json_array_field(document: string, field: string) string {
    let marker: string = "\"" + field + "\":["
    let at: i32 = str_index_of(document, marker)
    if at < 0 {
        return ""
    }
    let start: u32 = (at as u32) + strlen(marker)
    let rest: string = str_slice(document, start, strlen(document) - start)
    let end: i32 = str_index_of(rest, "]")
    if end < 0 {
        return ""
    }
    return str_slice(rest, 0, end as u32)
}
