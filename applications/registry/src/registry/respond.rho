module registry.respond

// Response builders for the registry, so the protocol shape lives in one
// place and the handlers read as protocol rather than as string building.

import std.web.http

// A uniform error body, which is what the Rho module client reports back.
fn error_json(status: u32, message: string) Response {
    return json(status, "{\"error\":\"" + message + "\"}")
}

// The body returned after a successful publish.
fn published_json(name: string, version: string) Response {
    return json(status_created(), "{\"name\":\"" + name + "\",\"version\":\"" + version + "\"}")
}

// The metadata recorded for an upload. The name and version come from the
// path the client posted to; the rest is what it sent as query parameters, so
// a listing shows the manifest rather than blanks.
//
// The values are passed in rather than read from a request, so this stays pure
// and can be tested without a server.
//
// Author and Maintainer are the module's own claim about who wrote and looks
// after it, taken from its manifest. Owner is the identity the registry
// recorded from the credential that published the module, which is the one it
// can actually verify and the one a withdrawal is checked against. They are
// separate because a module may be written by one person and published by
// another, and a registry that confused the two would let anyone who wrote a
// name into a file claim a module.
//
// Release and Released are what this version changed and when, taken from the
// module's own changelog. They are per version rather than per module, because
// the description says what a module is and does not change between releases,
// while the release note says what is different about this one — which is the
// only thing that tells two versions apart in a list.
//
// Every value goes through json_string rather than into the document raw: a
// description or a release note can contain a quote, a newline or a backslash,
// and a document built by pasting one in is a document that stops parsing the
// first time somebody writes an apostrophe the wrong way.
//
// Signer and signature are the publisher's own signature over the package's digest,
// stored as sent. The registry does not check them: a client does, against a key it
// has pinned, which is what makes a signature mean something the registry cannot
// forge. They are empty for a publisher who does not sign.
fn meta_json(name: string, version: string, kind: string, description: string, main: string, command: string, author: string, maintainer: string, owner: string, visibility: string, release: string, released: string, signer: string, signature: string) string {
    return "{\"name\":" + json_string(name) + ",\"version\":" + json_string(version) +
        ",\"type\":" + json_string(kind) + ",\"description\":" + json_string(description) +
        ",\"main\":" + json_string(main) + ",\"command\":" + json_string(command) +
        ",\"author\":" + json_string(author) + ",\"maintainer\":" + json_string(maintainer) +
        ",\"owner\":" + json_string(owner) + ",\"visibility\":" + json_string(visibility) +
        ",\"release\":" + json_string(release) + ",\"released\":" + json_string(released) +
        ",\"signer\":" + json_string(signer) + ",\"signature\":" + json_string(signature) +
        ",\"features\":[],\"deps\":{}}"
}
