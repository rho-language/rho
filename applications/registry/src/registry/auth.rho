module registry.auth


// Token issuance and checking for the registry.
//
// Reading is public, so anyone can browse the index, search, and pull a
// published package. Publishing is not: it needs a token, obtained by logging
// in with `rho auth login`.
//
// A token is minted here rather than by the client, so the signing secret
// never leaves this service.

import std.web.http

/* -------------------------------------------------------------------------- */
/*  Routes                                                                    */
/* -------------------------------------------------------------------------- */

/* -------------------------------------------------------------------------- */
/*  Who is asking                                                              */
/* -------------------------------------------------------------------------- */

// caller_identity is who is asking, from the credential they presented, or ""
// when they presented none.
//
// It lives here rather than beside the handlers that use it because it is a fact
// about a credential, and because the pages and the API both need it: a page and
// an API that disagreed about who is asking would disagree about which private
// modules exist, which is the one thing a reader would notice.
fn caller_identity(req: Request) string {
    if !auth_is_authenticated(request_auth(req)) {
        return ""
    }
    return auth_subject(request_auth(req))
}

route POST "/auth/token" => issue_token

/* -------------------------------------------------------------------------- */
/*  Scopes                                                                    */
/* -------------------------------------------------------------------------- */

fn scope_pull() string {
    return "pull"
}

fn scope_push() string {
    return "push"
}

/* -------------------------------------------------------------------------- */
/*  Issuing                                                                   */
/* -------------------------------------------------------------------------- */

// The longest a token may live, and how long one lasts by default. Both come
// from the settings, so a deployment can change them without a rebuild, and the
// ceiling is still enforced here rather than only in the signer.
fn max_token_days() u32 {
    return registry_token_max_days()
}

fn default_token_days() u32 {
    return registry_token_days()
}

// issue_token hands a caller a token for a subject.
//
// The lifetime asked for is capped, so a caller cannot ask for a credential
// that outlives the maximum.
fn issue_token(req: Request) Response {
    let user: string = request_query_param(req, "user")
    let host: string = request_query_param(req, "host")
    let days: u32 = parse_days(request_query_param(req, "days"))
    let scopes: string = request_query_param(req, "scopes")

    if user == "" {
        return error_json(status_bad_request(), "user is required")
    }
    if days > max_token_days() {
        days = max_token_days()
    }
    if days == 0 {
        days = default_token_days()
    }

    // Issuing a token decides who may publish, so it is closed unless one of a
    // few things is true: the deployment opened it for itself, the caller holds
    // the administrator secret, the caller is renewing a token for the subject
    // it already is, or the subject is one the deployment allowlisted. A
    // registry that mints a token for any name it is handed has no owners at
    // all, however careful its records.
    if !auth_open_tokens() {
        let administrator: bool = auth_bootstrap(request_auth(req))
        let renewing_own: bool = auth_is_authenticated(request_auth(req)) && auth_subject(request_auth(req)) == user
        if !administrator && !renewing_own && !auth_allowed(user) {
            warn("registry", "token refused for " + user + ", issuance is closed")
            return error_json(status_unauthorized(),
                "token issuance is closed; an administrator must mint one, or present the administrator secret")
        }
    }

    return json(status_created(), auth_issue(user, host, days, scopes))
}

// parse_days reads a requested lifetime, treating anything unusable as unset.
fn parse_days(value: string) u32 {
    if value == "" {
        return 0
    }
    return int_from_str(value)
}
