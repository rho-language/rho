module registry.storage

// The storage port for the registry service.
//
// Rho has no heap, no globals and no file I/O, so persistence sits behind
// this interface. The handlers declare these as `extern fn` and ports/store.go
// supplies the implementation for the Go target, so the split uses the
// compiler's existing extern mechanism rather than teaching it about a
// registry.
//
// A zero return means success.

// Store an uploaded package and its metadata. Returns 0 on success.
//
// The publisher is the identity the caller presented, which the handler has
// taken from its credential. The store compares it against what the module
// already records, so a module that is already published can only be added to
// by the identities that hold it.
extern fn store_put(name: string, version: string, publisher: string, payload: string, meta: string) u32

// The stored package for a version, or "" when it is absent.
extern fn store_get(name: string, version: string) string

// Whether a version is already published.
extern fn store_has(name: string, version: string) bool

// Withdraw a published version, and everything made from it.
//
// The package, the documentation generated from it, the unpacked sources and
// the index entry all go: a version that is half removed still answers a
// search and still serves documentation, and no longer holds what those were
// made from. Returns 0 on success.
extern fn store_delete(name: string, version: string) u32

// A JSON document naming who may withdraw a module, or "" when the module is not
// published here.
//
// It is the store's own answer rather than a handler's, because the record the
// check reads has to be the one the store acts on: a handler that kept its own
// copy of who owns what could be brought into step with the store, and then
// would not be.
extern fn store_publisher(name: string) string

// Record whether a module is anybody's to install or its owner's alone.
// Returns 0 on success.
extern fn store_set_visibility(name: string, visibility: string) u32

// A JSON array of module metadata matching a query, as seen by one identity.
//
// Visibility is applied here rather than by a handler, because what a caller may
// be told is a property of the store's record: a private module is only in the
// answer for its owner. `mine` narrows it to the caller's own modules, whatever
// their visibility.
extern fn store_search(query: string, viewer: string, mine: bool) string

// A JSON document listing a module's stored versions.
extern fn store_versions(name: string) string

// The directory the service stores modules in.
extern fn store_data_dir() string

// Documentation, generated from a published module rather than sent with it.
//
// A registry receives a package and documents it: the package is unpacked into
// a source tree, the documentation generator is given that tree, and the pages
// it wrote are served back from here.

// Unpack a published package into a source tree and return the directory, or ""
// when the package cannot be read. The tree is what a generator is given.
extern fn store_unpack(name: string, version: string) string

// A generated documentation page, or "" when it is absent. An empty page name
// answers the index.
extern fn store_doc_page(name: string, version: string, page: string) string

// Whether a version has documentation, which is what a page checks before it
// offers a link to it.
extern fn store_has_docs(name: string, version: string) bool

// The address the documentation this service publishes is served under, and what
// the service is called there. The generator writes it into every page it
// produces, so a reader who followed a link out of the service and into a
// module's documentation has a way back.
extern fn store_doc_home(home: string, title: string) void
