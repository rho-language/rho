module registry

// The remote registry for Rho modules. It speaks the three endpoints the Rho
// module client uses:
//
//	POST /modules/{name}/{version}/rho-pkg   publish a module package
//	GET  /modules/{name}/{version}/rho-pkg   download a module package
//	GET  /search?q=<query>                   search published modules
//
// The routes, the protocol and the responses are Rho. Storage and the
// byte-level string helpers sit behind a port, because Rho has no heap and no
// file I/O yet.

// The storage port is included rather than imported: an included file keeps
// its declarations in this module, so the extern names stay exactly as
// declared and the generated port can implement them. An imported module
// would qualify them with the module name, which a generated port does not.
include "registry/storage.rho"

import std.web.http
import rho.log
import registry.validate
import registry.respond
import registry.web
import registry.auth
import registry.docs

route POST "/modules/{name}/{version}/rho-pkg"     => publish_module
route GET  "/modules/{name}/{version}/rho-pkg"     => download_module
route GET  "/modules/{name}/{version}/docs/{path...}" => docs_page
route GET  "/api/search"                           => search_modules
route GET  "/api/modules/{name}"                   => module_versions
route GET  "/openapi.json"                         => openapi_docs

/* -------------------------------------------------------------------------- */
/*  Handlers                                                                   */
/* -------------------------------------------------------------------------- */

// openapi_docs serves the registry's own API description.
//
// A description nobody can fetch is a description only the people who read the
// repository have, and the point of publishing one is that a stranger can. It
// is written when the registry is built, from these routes, so what it says
// about the service is what the service does.
fn openapi_docs(req: Request) Response {
    return json(status_ok(), openapi_document())
}

fn publish_module(req: Request) Response {
    // Reading is public, so publishing is what a credential is for. A registry
    // configured access = public lets anyone publish, which suits a trusted
    // network; access = secured requires a valid token.
    if is_secured() && !auth_is_authenticated(request_auth(req)) {
        warn("registry", "publish refused, no valid token")
        return error_json(status_unauthorized(), "a token is required to publish")
    }

    let name: string = param(req, "name")
    let version: string = param(req, "version")

    if !valid_name(name) {
        warn("registry", "publish refused, invalid module name")
        return error_json(status_bad_request(), "invalid module name")
    }
    if !valid_version(version) {
        warn("registry", "publish refused, invalid version")
        return error_json(status_bad_request(), "invalid version")
    }

    let payload: string = request_body(req)
    if strlen(payload) == 0 {
        return error_json(status_bad_request(), "empty package")
    }
    if strlen(payload) > max_upload() {
        return error_json(status_payload_too_large(), "package too large")
    }
    if store_has(name, version) {
        warn("registry", "publish refused, version already published")
        return error_json(status_conflict(), "version already published")
    }

    // The store validates the module name and refuses to write outside the data
    // directory, so a rejected name is reported as a bad request.
    // The handler reads the request, so the response shaping stays pure.
    let meta: string = meta_json(
        name, version,
        request_query_param(req, "type"),
        request_query_param(req, "description"),
        request_query_param(req, "main"),
        request_query_param(req, "command")
    )
    if store_put(name, version, payload, meta) != 0 {
        error("registry", "publish failed, the store refused the write")
        return error_json(status_bad_request(), "invalid module name")
    }
    // The package is stored, so the publish has succeeded. Documentation is
    // generated from what was stored, and a module that cannot be documented is
    // still published: a reader sees a version with no docs link rather than a
    // publish that failed for a page nobody asked to read.
    doc_generate(name, version)
    info("registry", "published " + name + "@" + version)
    return published_json(name, version)
}

// docs_page serves one page of a published version's documentation.
//
// The path is a remainder rather than one segment, because a documentation site
// is a directory of pages: the index, a page per module and a stylesheet. The
// store reads the page, so a path that climbs out of the documentation
// directory is refused by the same check that refuses a name that climbs out of
// the data directory.
fn docs_page(req: Request) Response {
    return doc_page(param(req, "name"), param(req, "version"), param(req, "path"))
}

fn download_module(req: Request) Response {
    let name: string = param(req, "name")
    let version: string = param(req, "version")

    if !valid_name(name) || !valid_version(version) {
        return error_json(status_bad_request(), "invalid module name or version")
    }
    if !store_has(name, version) {
        warn("registry", "download missed " + name + "@" + version)
        return error_json(status_not_found(), "not found")
    }

    let payload: string = store_get(name, version)
    if strlen(payload) == 0 {
        error("registry", "download failed, stored package is empty")
        return error_json(status_not_found(), "not found")
    }
    debug("registry", "served " + name + "@" + version)
    return Response{ status_ok(), payload, "application/gzip" }
}

fn search_modules(req: Request) Response {
    return json(status_ok(), store_search(request_query_param(req, "q")))
}

fn module_versions(req: Request) Response {
    return json(status_ok(), store_versions(param(req, "name")))
}

// init runs before the service starts, on every target: the generated server
// calls it, and so does the native entry point. Startup belongs here rather
// than in main, which a server target does not use.
fn init() void {
    // The documentation generator is told where this service is published, so
    // every page it writes carries a way back here.
    doc_home()
    print("rho registry listening; data dir: " + store_data_dir())
    info("registry", "starting, data_dir=" + store_data_dir() + " access=" + registry_access())
}
