module std.embedded.modbus_test

import std.embedded.modbus
import std.core.slice
import std.core.ptr

fn assert(cond: bool, msg: String) void {
    if !cond {
        panic(msg)
    }
}

/* -------------------------------------------------------------------------- */
/*  Test CRC16                                                                */
/* -------------------------------------------------------------------------- */

fn test_crc16() void {
    let raw: u8[6]
    raw[0] = 0x01   // addr
    raw[1] = 0x03   // func
    raw[2] = 0x00   // start_hi
    raw[3] = 0x10   // start_lo
    raw[4] = 0x00   // qty_hi
    raw[5] = 0x02   // qty_lo

    let s: Slice[u8] = Slice[u8]{ Ptr[u8](&raw[0]), 6 }

    let crc: u16 = modbus.crc16_modbus(s)

    // CRC known from Modbus spec for this frame: 0xC5C9
    assert(crc == 0xC5C9, "CRC16 mismatch")
}

/* -------------------------------------------------------------------------- */
/*  Test frame build for read_holding                                         */
/* -------------------------------------------------------------------------- */

fn test_read_frame() void {
    let bus: modbus.Modbus = modbus.init(
        // fake RS485 device
        RS485{ 0, 0 },
        1      // slave address
    )

    let out_raw: u16[4]
    let out: Slice[u16] = Slice[u16]{ Ptr[u16](&out_raw[0]), 4 }

    // We cannot test UART/RS485 here → we test only frame parsing logic.
    // Simulate a valid Modbus RTU response:
    //
    // addr=1, func=3, byte_count=4, data=[0x00 0x2A, 0x00 0x2B], CRC=valid
    //
    let rx_raw: u8[9]
    rx_raw[0] = 1
    rx_raw[1] = 3
    rx_raw[2] = 4
    rx_raw[3] = 0x00
    rx_raw[4] = 0x2A
    rx_raw[5] = 0x00
    rx_raw[6] = 0x2B

    // compute CRC for the first 7 bytes
    let s: Slice[u8] = Slice[u8]{ Ptr[u8](&rx_raw[0]), 7 }
    let crc: u16 = modbus.crc16_modbus(s)
    rx_raw[7] = u8(crc & 0xFF)
    rx_raw[8] = u8(crc >> 8)

    // Now test the parser
    let ok: bool = modbus.parse_read_response(
        Slice[u8]{ Ptr[u8](&rx_raw[0]), 9 },
        out
    )

    assert(ok, "read_holding parse failed")
    assert(out.ptr[0] == 0x002A, "reg0 mismatch")
    assert(out.ptr[1] == 0x002B, "reg1 mismatch")
}

/* -------------------------------------------------------------------------- */
/*  Entry point                                                               */
/* -------------------------------------------------------------------------- */

fn main() void {
    test_crc16()
    test_read_frame()
}
