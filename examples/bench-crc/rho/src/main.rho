// bench-crc-rho — a CRC-32 benchmark written in Rho.
//
// The same program as examples/bench-crc/c/src/main.c, written in Rho.
// Both compute CRC-32 over a 1 KiB buffer 10000 times and print the
// digest in decimal so the compiler cannot optimise the work away.
//
// Build with:  rho build
// Measure:    rho bench --binary build/output/bench-crc-rho
//            rho mem --binary build/output/bench-crc-rho
//
// @project Rho Programming Language
// @license Apache-2.0

module main

fn crc32_byte(crc: u32, byte: u8) u32 {
    let c: u32 = crc ^ u32(byte)
    let i: u32 = 0
    while i < 8 {
        if (c & 1) != 0 {
            c = (c >> 1) ^ 0xEDB88320
        } else {
            c = c >> 1
        }
        i = i + 1
    }
    return c
}

fn crc32_buffer(data: u8[1024], length: u32) u32 {
    let crc: u32 = 0xFFFFFFFF
    let i: u32 = 0
    while i < length {
        crc = crc32_byte(crc, data[i])
        i = i + 1
    }
    return crc ^ 0xFFFFFFFF
}

fn main() void {
    let buf_raw: u8[1024]

    // Fill the buffer with deterministic data.
    let i: u32 = 0
    while i < 1024 {
        buf_raw[i] = u8(i & 0xFF)
        i = i + 1
    }

    let result: u32 = 0
    let n: u32 = 0
    while n < 10000 {
        result = result ^ crc32_buffer(buf_raw, 1024)
        n = n + 1
    }

    print(string.from_i32(result as i32))
}
