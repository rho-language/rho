// tic-tac-toe in Rho — interactive game with minimax AI.
//
// Exercises: structs, recursion, extern calls (getchar, rand, srand),
// 1D arrays (u8[9] as board), while loops, if/else, nested functions.
//
// Cell values: 0=empty, 1=human(X), 2=computer(O)
//
// @project Rho Programming Language
// @license Apache-2.0

module main

extern fn getchar() i32
extern fn rand() i32
extern fn srand(seed: u32)

struct Move {
    row: u32
    col: u32
}

fn cell_char(cell: u8) string {
    if cell == 0 { return " " }
    if cell == 1 { return "X" }
    return "O"
}

fn show_board(board: u8[9]) void {
    print("\n")
    print(cell_char(board[0]))
    print(" | ")
    print(cell_char(board[1]))
    print(" | ")
    print(cell_char(board[2]))
    print("\n")
    print("----------\n")
    print(cell_char(board[3]))
    print(" | ")
    print(cell_char(board[4]))
    print(" | ")
    print(cell_char(board[5]))
    print("\n")
    print("----------\n")
    print(cell_char(board[6]))
    print(" | ")
    print(cell_char(board[7]))
    print(" | ")
    print(cell_char(board[8]))
    print("\n\n")
}

fn show_instructions() void {
    print("Tic-Tac-Toe\n\n")
    print("Choose a cell numbered from 1 to 9 as below and play\n\n")
    print(" 1 | 2 | 3 \n")
    print("-----------\n")
    print(" 4 | 5 | 6 \n")
    print("-----------\n")
    print(" 7 | 8 | 9 \n\n")
}

fn is_moves_left(board: u8[9]) bool {
    let i: u32 = 0
    while i < 9 {
        if board[i] == 0 { return true }
        i = i + 1
    }
    return false
}

fn evaluate(board: u8[9]) i32 {
    // Rows
    let i: u32 = 0
    while i < 3 {
        let r: u32 = i * 3
        if board[r] != 0 && board[r] == board[r + 1] && board[r + 1] == board[r + 2] {
            if board[r] == 1 { return 10 }
            return -10
        }
        i = i + 1
    }

    // Columns
    let j: u32 = 0
    while j < 3 {
        if board[j] != 0 && board[j] == board[j + 3] && board[j + 3] == board[j + 6] {
            if board[j] == 1 { return 10 }
            return -10
        }
        j = j + 1
    }

    // Diagonals
    if board[0] != 0 && board[0] == board[4] && board[4] == board[8] {
        if board[0] == 1 { return 10 }
        return -10
    }
    if board[2] != 0 && board[2] == board[4] && board[4] == board[6] {
        if board[2] == 1 { return 10 }
        return -10
    }

    return 0
}

fn minimax(board: u8[9], depth: u32, is_max: bool) i32 {
    let score: i32 = evaluate(board)

    if score == 10 { return score }
    if score == -10 { return score }
    if !is_moves_left(board) { return 0 }

    if is_max {
        let best: i32 = -1000
        let i: u32 = 0
        while i < 9 {
            if board[i] == 0 {
                board[i] = 2  // computer
                let val: i32 = minimax(board, depth + 1, false)
                if val > best { best = val }
                board[i] = 0
            }
            i = i + 1
        }
        return best
    } else {
        let best: i32 = 1000
        let i: u32 = 0
        while i < 9 {
            if board[i] == 0 {
                board[i] = 1  // human
                let val: i32 = minimax(board, depth + 1, true)
                if val < best { best = val }
                board[i] = 0
            }
            i = i + 1
        }
        return best
    }
}

fn find_best_move(board: u8[9]) Move {
    let best_val: i32 = -1000
    let best: Move = Move{ 0, 0 }
    let i: u32 = 0
    while i < 9 {
        if board[i] == 0 {
            board[i] = 2
            let move_val: i32 = minimax(board, 0, false)
            board[i] = 0
            if move_val > best_val {
                best_val = move_val
                best.row = i / 3
                best.col = i % 3
            }
        }
        i = i + 1
    }
    return best
}

fn row_crossed(board: u8[9]) bool {
    let i: u32 = 0
    while i < 3 {
        let r: u32 = i * 3
        if board[r] != 0 && board[r] == board[r + 1] && board[r + 1] == board[r + 2] { return true }
        i = i + 1
    }
    return false
}

fn column_crossed(board: u8[9]) bool {
    let i: u32 = 0
    while i < 3 {
        if board[i] != 0 && board[i] == board[i + 3] && board[i + 3] == board[i + 6] { return true }
        i = i + 1
    }
    return false
}

fn diagonal_crossed(board: u8[9]) bool {
    if board[0] != 0 && board[0] == board[4] && board[4] == board[8] { return true }
    if board[2] != 0 && board[2] == board[4] && board[4] == board[6] { return true }
    return false
}

fn game_over(board: u8[9]) bool {
    return row_crossed(board) || column_crossed(board) || diagonal_crossed(board)
}

fn declare_winner(whose_turn: u32) void {
    if whose_turn == 2 {
        print("COMPUTER has won\n")
    } else {
        print("HUMAN has won\n")
    }
}

fn main() void {
    srand(1)

    let board: u8[9]
    let i: u32 = 0
    while i < 9 {
        board[i] = 0
        i = i + 1
    }

    show_instructions()

    let whose_turn: u32 = 2  // computer starts
    let move_index: u32 = 0

    while !game_over(board) && move_index != 9 {
        if whose_turn == 2 {
            let temp_board: u8[9]
            let t: u32 = 0
            while t < 9 {
                if board[t] == 1 { temp_board[t] = 1 }
                else if board[t] == 2 { temp_board[t] = 2 }
                else { temp_board[t] = 0 }
                t = t + 1
            }

            let this_move: Move = find_best_move(temp_board)
            let x: u32 = this_move.row
            let y: u32 = this_move.col
            board[x * 3 + y] = 2

            print("COMPUTER has put a O in cell ")
            print(string.from_i32(x as i32))
            print(" ")
            print(string.from_i32(y as i32))
            print("\n")
            show_board(board)
            move_index = move_index + 1
            whose_turn = 1
        } else {
            print("Enter your move (1-9): ")
            let c: i32 = getchar()
            let timeout: i32 = 0
            while c == -1 { 
                if timeout == 0xffffffff { return }
                timeout = timeout + 1
                c = getchar()
            }  // EOF
            if c == 10 {  // bare newline
                print("Enter a number between 1 and 9.\n")
            } else {
                let ch: i32 = c
                while ch != -1 && ch != 10 { ch = getchar() }
                let move_num: u32 = u32(c - 48)
                if move_num < 1 || move_num > 9 {
                    print("Invalid input! Enter a number between 1 and 9.\n")
                } else {
                    let pos: u32 = move_num - 1
                    if board[pos] == 0 {
                        board[pos] = 1
                        show_board(board)
                        move_index = move_index + 1
                        if game_over(board) {
                            declare_winner(1)
                            return
                        }
                        whose_turn = 2
                    } else {
                        print("Cell is already occupied. Try again.\n")
                    }
                }
            }
        }
    }

    if !game_over(board) && move_index == 9 {
        print("It's a draw\n")
    } else {
        if whose_turn == 2 { whose_turn = 1 }
        else { whose_turn = 2 }
        declare_winner(whose_turn)
    }
}
