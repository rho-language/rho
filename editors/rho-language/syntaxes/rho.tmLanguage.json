{
  "name": "Rho",
  "scopeName": "source.rho",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rho",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rho",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rho",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rho",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rho",
          "match": "\\b(module|import|include|fn|extern|struct|enum|type|config|route|let|const|if|else|for|while|match|return|reverse|step|break)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.rho",
          "match": "\\b(u8|u16|u32|u64|i32|i64|f32|f64|bool|string|void|Unit|RhoUnit|Slice|Ptr|Option|Result|Array|Map|String|true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rho",
          "match": "\\b(?:0x[0-9A-Fa-f]+|[0-9]+(?:\\.[0-9]+)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rho",
          "match": "==|!=|<=|>=|&&|\\|\\||=>|->|::|[+*/%<>=!&|^-]"
        }
      ]
    }
  }
}
