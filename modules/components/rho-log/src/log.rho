module rho.log

// A small Rho-side logging surface, so a Rho service can emit records through
// the same formatter the component's own Go command uses.
//
// The backend supplies the sinks; this is the vocabulary around them.

extern fn emit(level: u32, subject: string, message: string)

// log_configure applies the application's logging policy. The host calls it
// after reading its settings; the port owns the level filter, the text/JSON
// formatter and the rotating file.
extern fn log_configure(level: u32, format: string, file: string,
    max_bytes: i64, keep: u32, stderr: u32)

// configure is a library function rather than a direct extern call so the
// application's call is resolved inside this module; the port then supplies the
// implementation, exactly as it does for emit.
fn configure(level: u32, format: string, file: string, max_bytes: i64,
    keep: u32, stderr: u32) void {
    log_configure(level, format, file, max_bytes, keep, stderr)
}

fn trace(subject: string, message: string) void {
    emit(0, subject, message)
}

fn debug(subject: string, message: string) void {
    emit(1, subject, message)
}

fn info(subject: string, message: string) void {
    emit(2, subject, message)
}

fn warn(subject: string, message: string) void {
    emit(3, subject, message)
}

fn error(subject: string, message: string) void {
    emit(4, subject, message)
}

fn fatal(subject: string, message: string) void {
    emit(5, subject, message)
}
