    "i2c0": { "instance": "i2c0", "pins": { "sda": "GP4", "scl": "GP5" } },
    "spi0": { "instance": "spi0", "pins": { "rx": "GP16", "cs": "GP17", "sck": "GP18", "tx": "GP19" } }
