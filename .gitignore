# Standalone deployment package, produced by ./scripts/build.sh
/deploy/

# CMake build output
/build/
/build-*/
cmake-build-*/
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile

# Generated configuration and staging output
/generated/
/stage/

# Resolved dependency lockfiles, produced by a build
rho.lock

# The Rho a project's SQL generates, written beside the project's own sources so
# the compiler and the project are reading one set of files.
#
# They are outputs: a build runs the generator before it compiles, and the
# statements come from the schema the project declared. A deployment therefore
# generates them, and keeping a copy here would only risk a checked-in file
# disagreeing with the schema it was generated from.
applications/registry/src/db/

# A component's or plugin's built command, which `rho module publish` packs
# beside the manifest. It is a build artefact of the module, not a source file.
modules/components/*/rho-*
modules/plugins/*/rho-*

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache

# Test and coverage output
Testing/
coverage/
*.gcda
*.gcno
*.gcov

*.lock

# Local IDE and OS files
.vscode/
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store

# Built binaries written where the project declares.
output/

# The workspace's checksum cache. Derived, and nothing depends on which of its
# entries happen to be there: `go` writes whatever is missing on the next build.
# Its per-module equivalents are tracked, so this is the one of the three that is
# only a cache.
go.work.sum

# The C a compiler test generates, when a test is interrupted before it is
# removed. It is not source, and a stray one in a Go package is a package that
# does not build.
src/*.c
src/*_test.c
src/*_bin
