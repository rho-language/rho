# CMake build output
/build/
/build-*/
cmake-build-*/
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile

# Generated configuration and staging output
/generated/
/stage/

# Resolved dependency lockfiles, produced by a build
rho.lock

# A component's or plugin's built command, which `rho module publish` packs
# beside the manifest. It is a build artefact of the module, not a source file.
modules/components/*/rho-*
modules/plugins/*/rho-*

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache

# Test and coverage output
Testing/
coverage/
*.gcda
*.gcno
*.gcov

*.lock

# Local IDE and OS files
.vscode/
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store
